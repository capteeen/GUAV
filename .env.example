# Solana devnet. No secrets. Leave blank until you deploy.

# Cluster RPC used by scripts
SOLANA_RPC_URL=https://api.devnet.solana.com

# Browser RPC. Public devnet rate-limits program scans; a private RPC is optional.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Placeholder program id until `anchor keys sync` / deploy. Do not treat this as mainnet.
# Current undeployed placeholder: 67HiGDKWjYSgGQNq7icz6vPRNNQAMogdzdJvgztYYPmX
NEXT_PUBLIC_GUAVA_PROGRAM_ID=

# Receives the 100 bps platform fee. A pubkey, not a private key.
NEXT_PUBLIC_GUAVA_FEE_RECIPIENT=

# Optional Privy Solana app id. The demo uses Wallet Adapter and does not require this.
NEXT_PUBLIC_PRIVY_APP_ID=

# USDC is not a curve quote. Listed so the unused mint is explicit.
# No canonical devnet USDC is assumed. Leave blank.
NEXT_PUBLIC_DEVNET_USDC_MINT=

# Explorer links for devnet accounts
NEXT_PUBLIC_EXPLORER_BASE=https://explorer.solana.com/?cluster=devnet
