{
  "name": "guava",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Guava — Solana token launchpad and discovery board",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "anchor:build": "mkdir -p target/deploy && cp keys/guava-program-keypair.json target/deploy/guava-keypair.json && anchor build",
    "anchor:test": "mkdir -p target/deploy && cp keys/guava-program-keypair.json target/deploy/guava-keypair.json && anchor test",
    "anchor:deploy": "mkdir -p target/deploy && cp keys/guava-program-keypair.json target/deploy/guava-keypair.json && anchor deploy --provider.cluster devnet --provider.wallet keys/local-test.json"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^5.0.0",
    "bn.js": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "chai": "^4.5.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "mocha": "^11.7.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.9.2"
  }
}
